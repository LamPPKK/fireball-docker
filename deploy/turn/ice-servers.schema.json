{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireball.dev/schemas/docker/ice-servers-v1.json",
  "title": "Fireball Docker ICE server configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "turn_servers", "ice_transport_policy"],
  "$defs": {
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9.:-]+$",
      "anyOf": [
        { "format": "ipv4" },
        { "format": "ipv6" },
        {
          "pattern": "^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
        }
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "credential": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!-~]+$"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stun_server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "port": { "$ref": "#/$defs/port" }
      }
    },
    "turn_servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "host", "port", "username", "password"],
        "properties": {
          "scheme": { "enum": ["turn", "turns"] },
          "host": { "$ref": "#/$defs/host" },
          "port": { "$ref": "#/$defs/port" },
          "username": {
            "allOf": [
              { "$ref": "#/$defs/credential" },
              { "type": "string", "maxLength": 128 }
            ]
          },
          "password": {
            "allOf": [
              { "$ref": "#/$defs/credential" },
              { "type": "string", "maxLength": 256 }
            ]
          }
        }
      }
    },
    "ice_transport_policy": {
      "enum": ["all", "relay"]
    }
  }
}
