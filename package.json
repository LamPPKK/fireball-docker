{
  "name": "@fireball/docker-orchestrator",
  "version": "0.1.0-dev.5",
  "private": true,
  "description": "Multi-tenant Fireball remote-browser orchestrator foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run contracts:check && npm run session:image:check && npm run session:check && npm run build && npm test",
    "contracts:generate": "node scripts/sync-xanhtab-contract.mjs",
    "contracts:check": "node scripts/check-xanhtab-contract.mjs",
    "dev": "node --enable-source-maps dist/src/main.js",
    "session:check": "npm run check --prefix session",
    "session:image:check": "node scripts/check-session-image.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.0",
    "jose": "6.2.9",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
