{
  "name": "@fireball/docker-orchestrator",
  "version": "0.1.0-dev.5",
  "private": true,
  "description": "Multi-tenant Fireball remote-browser orchestrator foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run contracts:check && npm run deployment:check && npm run seccomp:check && npm run session:image:check && npm run session:check && npm run build && npm test",
    "contracts:generate": "node scripts/sync-xanhtab-contract.mjs",
    "contracts:check": "node scripts/check-xanhtab-contract.mjs",
    "dev": "node --enable-source-maps dist/src/main.js",
    "deployment:check": "node --check scripts/render-nginx-config.mjs && node --check scripts/install-nginx-config.mjs && node --test test/deployment-adapters.test.mjs",
    "session:check": "npm run check --prefix session",
    "session:image:check": "node --check scripts/real-isolation-gate.mjs && node --check scripts/real-media-gate.mjs && node scripts/check-session-image.mjs",
    "session:isolation:smoke": "node scripts/real-isolation-gate.mjs",
    "session:media:smoke": "node scripts/real-media-gate.mjs",
    "seccomp:check": "node --check scripts/seccomp-profile.mjs && node scripts/seccomp-profile.mjs check",
    "seccomp:generate": "node scripts/seccomp-profile.mjs generate",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.0",
    "jose": "6.2.9",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
